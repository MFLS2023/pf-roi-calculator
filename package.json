{
  "name": "pf-roi-calculator",
  "version": "2.0.0",
  "description": "Prop Firm ROI Calculator — estimate exam/payout pass rates, accounts needed and ROI with the gambler's ruin model. Runs offline as a PWA and as a desktop app.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "keywords": [
    "prop-firm",
    "proprietary-trading",
    "roi",
    "calculator",
    "drawdown",
    "profit-target",
    "gamblers-ruin",
    "apex",
    "topstep",
    "fundednext",
    "ftmo",
    "pwa",
    "tauri",
    "offline"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 4173 --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "icons": "node scripts/generate-icons.mjs",
    "tauri": "npx --yes @tauri-apps/cli@^2",
    "desktop:dev": "npx --yes @tauri-apps/cli@^2 dev",
    "desktop:build": "npx --yes @tauri-apps/cli@^2 build"
  },
  "dependencies": {
    "qrcode-generator": "^1.4.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
